---
import { createHash } from 'node:crypto';
import fs from 'node:fs';
import { join } from 'node:path';
import sharp from 'sharp';
import { loadAvatarRegistry } from '../avatarRegistry';
import LogoRegistry, { type Logo } from '../components/LogoRegistry';

const collator = new Intl.Collator('zh-Hans-CN', {
  numeric: true,
  sensitivity: 'base',
});

const registry = loadAvatarRegistry();
const logos: Logo[] = (await Promise.all(fs.readdirSync('avatars').map(async (file) => {
  const filename = file.replace(/\.webp$/i, '');
  const aliases = registry.get(filename) ?? [];
  const contents = await fs.promises.readFile(join(process.cwd(), 'avatars', file));
  const { width = null, height = null } = await sharp(contents).metadata();
  return {
    name: aliases[0] ?? filename,
    aliases,
    src: `/org/${encodeURIComponent(file)}?build=${createHash('sha256').update(contents).digest('hex').slice(0, 12)}`,
    file,
    width,
    height,
  };
}))).sort((left, right) => collator.compare(left.name, right.name));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Hydro Contest Team School Logo Registry"
    />
    <link rel="icon" type="image/png" href="/HydroLogo.png" />
    <title>Hydro Contest Team School Logo Registry</title>
  </head>
  <body>
    <LogoRegistry client:load logos={logos} />
  </body>
</html>
